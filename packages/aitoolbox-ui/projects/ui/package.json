{
  "name": "@aitoolbox/ui",
  "version": "1.0.0",
  "description": "AIToolbox design system for Angular: theme files (M2 and M3), tokens, and UI Components built on Angular Material.",
  "keywords": [
    "angular",
    "angular-material",
    "design-system",
    "aitoolbox"
  ],
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "@angular/animations": "^21.2.0 || ^22.0.0",
    "@angular/cdk": "^21.2.0 || ^22.0.0",
    "@angular/common": "^21.2.0 || ^22.0.0",
    "@angular/core": "^21.2.0 || ^22.0.0",
    "@angular/material": "^21.2.0 || ^22.0.0",
    "@angular/router": "^21.2.0 || ^22.0.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@angular/animations": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    "./styles/aitoolbox-m3": {
      "sass": "./styles/aitoolbox-m3.scss",
      "default": "./styles/aitoolbox-m3.scss"
    },
    "./styles/aitoolbox-m2": {
      "sass": "./styles/aitoolbox-m2.scss",
      "default": "./styles/aitoolbox-m2.scss"
    },
    "./styles/breakpoints": {
      "sass": "./styles/_breakpoints.scss"
    },
    "./styles/theme-colors": {
      "sass": "./styles/_theme-colors.scss"
    },
    "./styles/tokens": {
      "sass": "./styles/_tokens.scss",
      "style": "./styles/tokens.css",
      "default": "./styles/tokens.css"
    },
    "./styles/*": {
      "sass": "./styles/*",
      "default": "./styles/*"
    },
    "./assets/*": "./assets/*",
    "./fonts/*": "./fonts/*",
    "./tokens/*": "./tokens/*"
  }
}
