  ],
  "libraries": [],
  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Material 3 buttons at 40 px, full-round, label-large."
    },
    {
      "name": "Card",
      "group": "Containers",
      "summary": "Three Material 3 card styles, radius-md (12 px), space-4 (16 px) padding, title-medium heading."
    },
    {
      "name": "Chip",
      "group": "Actions",
      "summary": "32 px, radius-sm (8 px), label-large at weight 500."
    },
    {
      "name": "Dialog",
      "group": "Containers",
      "summary": "Material 3 basic dialog carrying a short form."
    },
    {
      "name": "CatalogItem",
      "group": "Communication",
      "summary": "One item of the Catalog (a skill, a tool or an MCP server), minimal: a card with the kind tile, the name, one line and the author; a page with one action (Add to my assistant), what it uses, example requests and the Discussion panel."
    },
    {
      "name": "GuidedTour",
      "group": "Communication",
      "summary": "Spotlight (scrim 42 % with a cutout on the measured target, 2 px primary ring) and a step card beside it; targets are data-anchor ids, never coordinates."
    },
    {
      "name": "Discussion",
      "group": "Communication",
      "summary": "One expansion panel at the end of a release or an idea: the summary bar is its header (threads, messages, participants, last message); open, threads three at a time with Show more, each an opening message and its replies with role chips, Reply, and a new-message field."
    },
    {
      "name": "ReleaseItem",
      "group": "Communication",
      "summary": "What's new entry, layout D · Changelog: meta, title, summary, one table row per change, one action line ending with Useful?, then the Discussion panel."
    },
    {
      "name": "FeedbackProfile",
      "group": "Communication",
      "summary": "The feedback-form editor in Community › Feedback (admin only): entry points, up to 3 questions, sampling, routing, options, with a live preview of the side sheet; feature admins see only their own profile through a scoped right."
    },
    {
      "name": "Loader",
      "group": "Feedback",
      "summary": "Two kinds of waiting: the brand loader for app-level waits, Material indicators for everything inside a screen."
    },
    {
      "name": "StatusChip",
      "group": "Feedback",
      "summary": "Health and log-level colour, kept apart from the brand colours so a green dot means the same thing on every screen."
    },
    {
      "name": "TextField",
      "group": "Inputs",
      "summary": "Outlined Material 3 text field, 56 px, radius-xs, floating label on the surface colour behind it."
    },
    {
      "name": "Subheader",
      "group": "Navigation",
      "summary": "The first row of a page under another one: back arrow named by where it goes, the page's title, one status, its context in body-small and its actions, in one row. Replaces back buttons on their own row."
    }
  ],
