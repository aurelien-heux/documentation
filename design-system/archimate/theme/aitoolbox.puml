' Workflow step. by: human (default) | agent | system | gate | event. change: added | changed | moved | removed
!procedure AX_Step($label, $by="human", $change="")
!$mark = ""
!if ($by == "agent")
!$mark = "<size:10>✦ agent</size>\n"
!elseif ($by == "system")
!$mark = "<size:10>system</size>\n"
!elseif ($by == "gate")
!$mark = "<size:10>review gate</size>\n"
!elseif ($by == "event")
!$mark = "<size:10>event</size>\n"
!endif
!$cls = $by
!if ($change == "added")
!$text = "+ " + $label
!$cls = "added"
!elseif ($change == "changed")
!$text = "Δ " + $label
!$cls = "changed"
!elseif ($change == "moved")
!$text = "↕ " + $label
!$cls = "moved"
!elseif ($change == "removed")
!$text = "− <s>" + $label + "</s>"
!$cls = "removed"
!else
!$text = $label
!endif
!if ($cls == "human")
:$mark$text;
!else
:$mark$text; <<$cls>>
!endif
!endprocedure
!procedure AX_Gate($label, $change="")
AX_Step($label, "gate", $change)
!endprocedure
!procedure AX_Event($label, $change="")
AX_Step($label, "event", $change)
!endprocedure
