{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "experimentalDecorators": true, "useDefineForClassFields": false,
    "declaration": true, "sourceMap": true, "inlineSources": true, "importHelpers": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": []
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true, "strictInputAccessModifiers": true, "compilationMode": "partial" },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "stories/**"]
}
