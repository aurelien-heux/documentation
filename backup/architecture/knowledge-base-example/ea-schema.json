{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtoolbox.internal/ea-schema.json",
  "title": "Devtoolbox architecture knowledge base — Markdown frontmatter schema",
  "description": "Building blocks (requirements, ABB, SBB, plateaus, work packages, gaps) live in LikeC4 (model/bb/*.c4). Markdown holds what is text: requirement details, detailed design (DD), ADRs, notes on a building block, and ARB submissions with their ASD narrative. Every Markdown id that names a building block must exist in the LikeC4 model. Vocabulary: devtoolbox-domain-reference.md §5.",
  "type": "object",
  "required": ["id", "level", "updatedAt"],
  "properties": {
    "id":         { "type": "string", "pattern": "^(req|dd|adr|arb|mot|abb|sbb|imp)\\.[a-z0-9-]+\\.[a-z0-9.-]+$" },
    "level":      { "enum": ["requirement", "dd", "adr", "note", "arb"] },
    "kind":       { "type": "string" },
    "title":      { "type": "string", "minLength": 3 },
    "application":{ "type": "string", "pattern": "^[a-z0-9-]+$", "description": "applicationSlug (CTX-CAT)." },
    "module":     { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$", "description": "applicationSlug/moduleName." },
    "owner":      { "type": "string", "description": "teamId." },
    "status":     { "type": "string" },
    "updatedAt":  { "type": "string", "format": "date" },

    "realizes":   { "type": "array", "items": { "type": "string" }, "description": "dd: SBB ids in the LikeC4 model." },
    "dependsOn":  { "type": "array", "items": { "type": "string" } },
    "adr":        { "type": "array", "items": { "type": "string", "pattern": "^adr\\." } },
    "workItemId": { "type": "string", "pattern": "^WI-[0-9]+$" },
    "jira":       { "type": "string" },
    "contract":   { "type": "string" },
    "links":      { "type": "array", "items": { "type": "string" } },
    "tags":       { "type": "array", "items": { "type": "string" } },

    "acceptance": { "type": "array", "items": { "type": "object", "required": ["given", "when", "then"],
                    "properties": { "given": {"type":"string"}, "when": {"type":"string"}, "then": {"type":"string"} } } },
    "decisionTable": { "type": "array", "items": { "type": "object", "required": ["case", "outcome"],
                    "properties": { "case": {"type":"string"}, "outcome": {"enum":["OK","KO"]}, "reason": {"type":"string"} } } },
    "operational": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },

    "decision":   { "type": "string" },
    "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^adr\\." } },
    "domainRef":  { "type": "string", "pattern": "^(DEC|INV|OPP)-" },
    "affects":    { "type": "array", "items": { "type": "string" } },

    "board":       { "type": "string" },
    "boardDate":   { "type": "string", "format": "date" },
    "submittedBy": { "type": "string" },
    "submittedAt": { "type": "string", "format": "date" },
    "from":        { "type": "string", "pattern": "^imp\\.", "description": "arb: plateau compared from." },
    "to":          { "type": "string", "pattern": "^imp\\.", "description": "arb: plateau compared to." },
    "requirements":{ "type": "array", "items": { "type": "string", "pattern": "^req\\." } },
    "reviewers":   { "type": "array", "items": { "type": "object", "required": ["name", "role", "decision"],
                     "properties": { "name": {"type":"string"}, "role": {"type":"string"},
                                     "decision": {"enum": ["pending", "approved", "approved-with-conditions", "changes-requested", "rejected", "not-required"]},
                                     "at": {"type":"string"}, "note": {"type":"string"} } } },
    "conditions":  { "type": "array", "items": { "type": "object", "required": ["id", "text", "status"],
                     "properties": { "id": {"type":"string"}, "text": {"type":"string"}, "owner": {"type":"string"},
                                     "due": {"type":"string"}, "status": {"enum": ["open", "met", "waived"]} } } }
  },
  "additionalProperties": false,

  "$defs": {
    "levelRequires": {
      "requirement": ["acceptance"],
      "dd":          ["kind", "title", "application", "module", "owner", "status", "realizes"],
      "adr":         ["title", "application", "owner", "status", "decision", "affects"],
      "note":        [],
      "arb":         ["title", "application", "board", "boardDate", "status", "from", "to", "reviewers"]
    },
    "ddKinds": ["domain", "domain-events", "ports", "application", "infrastructure", "api", "data-model"],
    "statuses": ["draft", "ready", "done", "deprecated"],
    "arbStatuses": ["draft", "submitted", "in-review", "approved", "approved-with-conditions", "rejected"],
    "asdSections": ["Context and scope", "Business need", "Architecture overview", "Non-functional requirements", "Security", "Risks"],

    "kindMapping": {
      "description": "Design to Code: building-block kind or DD kind → what it becomes in the DD → Java (hexagonal) → test type.",
      "capability":            { "dd": "module boundary / bounded context",   "code": "Module (Maven / Spring Modulith)",          "test": "—" },
      "value-stream":          { "dd": "module boundary / bounded context",   "code": "Module",                                    "test": "—" },
      "business-process":      { "dd": "use-case orchestration (steps 1.x)",  "code": "application",                               "test": "use-case test" },
      "business-function":     { "dd": "grouping of use cases",               "code": "package of the module",                     "test": "—" },
      "business-object":       { "dd": "entity / aggregate, state machine",   "code": "domain.model",                              "test": "domain unit tests" },
      "business-event":        { "dd": "domain event",                        "code": "domain.event",                              "test": "domain unit tests" },
      "business-service":      { "dd": "inbound port (exposed use case)",     "code": "application.port.in",                       "test": "use-case test" },
      "business-interface":    { "dd": "access channel (screen, API, file)",  "code": "inbound adapter (api, batch…)",             "test": "end-to-end tests" },
      "business-role":         { "dd": "authorisation role",                  "code": "security configuration",                    "test": "authorisation tests" },
      "application-service":   { "dd": "inbound port implementation",         "code": "application.service",                       "test": "use-case test, outbound ports stubbed" },
      "application-interface": { "dd": "API contract (OpenAPI / AsyncAPI)",   "code": "REST controllers, DTOs (api)",              "test": "contract tests" },
      "application-component": { "dd": "deployable unit",                     "code": "Module / microservice, Git repository",     "test": "component integration tests" },
      "data-object":           { "dd": "data model",                          "code": "JPA entities, Liquibase changelogs",        "test": "integration tests (real DB)" },
      "application-event":     { "dd": "integration message (AsyncAPI)",      "code": "messaging adapter (infrastructure.messaging)","test": "contract + integration tests" },
      "technology-service":    { "dd": "outbound port + adapter",             "code": "infrastructure client",                     "test": "integration tests, service stubbed" },
      "system-software":       { "dd": "runtime dependency",                  "code": "configuration, Testcontainers image",       "test": "integration tests" },
      "artifact":              { "dd": "file format / schema",                "code": "schema + parser",                           "test": "schema tests" },
      "domain":                { "dd": "entities, value objects, aggregates, rules", "code": "domain",                             "test": "unit tests" },
      "domain-events":         { "dd": "events emitted by the domain",        "code": "domain.event",                              "test": "unit tests" },
      "ports":                 { "dd": "inbound / outbound interfaces",       "code": "application.port.in / .out",                "test": "— (contracts)" },
      "application":           { "dd": "use cases",                           "code": "application",                               "test": "use-case tests" },
      "infrastructure":        { "dd": "outbound adapters",                   "code": "infrastructure",                            "test": "integration tests" },
      "api":                   { "dd": "inbound REST adapters, DTO mapping",  "code": "api",                                       "test": "contract / web tests" },
      "data-model":            { "dd": "physical schema, migrations",         "code": "Liquibase, JPA entities",                   "test": "integration tests" }
    }
  }
}
