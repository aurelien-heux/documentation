// Views written by hand. Standard views (landscape per plateau, gap, roadmap, chain, one per element)
// are generated by tools/generate.py into dist/likec4/views.generated.c4.
views {
  view motivation {
    title 'Motivation · environments'
    description 'Why the change: stakeholders, driver, assessment, goal, outcome, requirements and constraints.'
    include mot.environments.*, req.environments.*
    autoLayout TopBottom 40 60
  }
}
